# Copy this file to .env and fill in your values.
# NEVER commit .env - the token gives full control over your bot.

# Get a token from @BotFather in Telegram (/newbot)
TELEGRAM_BOT_TOKEN=your-token-from-botfather

# How often all tracked products are checked (minutes, minimum 1)
CHECK_INTERVAL_MINUTES=60

# SQLite database file
DB_PATH=data/alerts.db

# Max. tracked products per chat
MAX_ITEMS_PER_CHAT=20

# Pause between two requests to the shop (seconds)
REQUEST_DELAY=1.0

# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# Connect to Telegram over IPv4 only. Set to true if you see
# "httpx.ConnectError" in the log (often a broken IPv6 route).
FORCE_IPV4=false
